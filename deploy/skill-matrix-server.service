[Unit]
Description=Skill Matrix API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=skill-matrix
Group=skill-matrix
WorkingDirectory=/opt/skill-matrix/current
EnvironmentFile=/etc/skill-matrix/server.env
ExecStart=/usr/local/bin/bun apps/server/src/index.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/skill-matrix /var/lib/skill-matrix

[Install]
WantedBy=multi-user.target
