APP_URL=https://skills.example.com
DATABASE_URL=postgres://skill_matrix:replace_me@127.0.0.1:5432/skill_matrix
HOST=127.0.0.1
PORT=3000
MATERIAL_STORAGE_DIR=/var/lib/skill-matrix/materials
MATERIAL_STORAGE_PROVIDER=filesystem
# COS 模式需要填写专用 CAM 子账号密钥；桶应保持 private，应用只写入下面的前缀。
# MATERIAL_STORAGE_PROVIDER=cos
# COS_BUCKET=skill-matrix-materials-<APPID>
# COS_REGION=ap-guangzhou
# COS_OBJECT_PREFIX=skill-matrix/
# COS_SECRET_ID=
# COS_SECRET_KEY=
# MES 只读拉取技能矩阵的共享 key（至少 32 位，与 MES 的 MES_SKILLS_API_KEY 同值）；不填则该接口返回 503。
# MES_SYNC_API_KEY=
