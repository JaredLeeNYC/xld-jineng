{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    },
    "types": ["bun", "node", "vite-plus/client"]
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/web/vite.config.ts",
    "packages/*/src/**/*.ts",
    "packages/db/drizzle.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "packages/db/drizzle/**"]
}
